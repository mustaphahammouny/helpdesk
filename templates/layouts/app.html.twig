{% extends 'layouts/base.html.twig' %}

{% block body %}
  <div class="page">
    {% include 'layouts/partials/header.html.twig' %}

    {% include 'layouts/partials/navbar.html.twig' %}

    <div class="page-wrapper">
      <div class="page-header d-print-none">
        <div class="container-xl">
          <div class="row g-2 align-items-center">
            <div class="col">
              <div class="page-pretitle">Overview</div>

              <h1 class="page-title">Navbar sticky</h1>
            </div>

            <div class="col-auto ms-auto d-print-none">
              <!-- BEGIN HEADER ACTIONS -->
              <div class="btn-list">
                <span class="d-none d-sm-inline"><button type="button" class="btn">New view</button></span>
                <a href="#" class="btn btn-primary d-none d-sm-inline-block" data-bs-toggle="modal" data-bs-target="#modal-report">
                  <!-- Download SVG icon from http://tabler.io/icons/icon/plus -->
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="icon">
                    <path d="M12 5l0 14" />
                    <path d="M5 12l14 0" />
                  </svg>Create new report
                </a>
                <a href="#" class="btn btn-primary d-sm-none btn-icon" data-bs-toggle="modal" data-bs-target="#modal-report" aria-label="Create new report">
                  <!-- Download SVG icon from http://tabler.io/icons/icon/plus -->
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="icon">
                    <path d="M12 5l0 14" />
                    <path d="M5 12l14 0" />
                  </svg>
                </a>
              </div>
              <!-- END HEADER ACTIONS -->
            </div>
          </div>
        </div>
      </div>

      <main id="content" class="page-body">
        <div class="container-xl">
          {% block content %}

          {% endblock %}
        </div>
      </main>

      {% include 'layouts/partials/footer.html.twig' %}
    </div>
  </div>
{% endblock %}
